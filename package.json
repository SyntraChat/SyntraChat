    "desktop:build": "tauri build --no-bundle --config src-tauri/tauri.release.conf.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.11.0",
    "eslint": "^10.15.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
