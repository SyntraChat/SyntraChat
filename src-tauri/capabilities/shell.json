{
  "identifier": "shell",
  "description": "Only the trusted local shell may manage accounts. No remote origins.",
  "local": true,
  "webviews": ["main"],
  "permissions": [
    "allow-snapshot", "allow-add-account", "allow-edit-account", "allow-remove-account",
    "allow-set-appearance", "allow-open-account", "allow-reload-account", "allow-close-account", "allow-quit",
    "allow-show-home", "allow-set-content-visible"
  ]
}
